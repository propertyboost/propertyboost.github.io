],"components":[{"type":"link","name":"Email Button","classes":["email-button"],"attributes":{"href":"mailto:valoriseimmo@gmail.com?subject=Contact Property Boost","id":"ib0dyj"},"components":[{"type":"image","name":"Email Icon","resizable":{"ratioDefault":1},"classes":["email-icon"],"attributes":{"src":"https://api.iconify.design/lucide-mail.svg?color=white","alt":"Email"}},{"type":"textnode","content":" valoriseimmo@gmail.com"}]},{"type":"link","name":"WhatsApp Button","classes":["whatsapp-button"],"attributes":{"href":"https://wa.me/555131999180?text=Hello!%20I%27ve%20seen%20your%20website%20and%20I%27m%20interested%20in%20improving%20the%20photos%20of%20my%20property.%20Could%20you%20tell%20me%20more%20about%20your%20services%20and%20pricing%3F","id":"i4ntef","target":"_blank","rel":"noopener noreferrer"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["phone-icon"],"attributes":{"src":"https://api.iconify.design/lucide-phone.svg?color=white","alt":"Phone","id":"i1bjzq"}},{"type":"textnode","content":" +55 51 3199 9180"}]}]}]}]}]}]}]},{"tagName":"footer","name":"Site Footer","classes":["site-footer"],"attributes":{"id":"iks1ra"},"components":[{"classes":["footer-container"],"attributes":{"id":"itfjbk"},"components":[{"tagName":"p","type":"text","classes":["font-script","footer-text"],"attributes":{"id":"i6km2o"},"components":[{"type":"textnode","content":"\n        Your property deserves to be seen at its very best.\n      "}]}]},{"type":"link","name":"Floating WhatsApp Button","editable":false,"classes":["whatsapp-button","floating-whatsapp-button"],"attributes":{"href":"https://wa.me/555131999180?text=Hello!%20I%27ve%20seen%20your%20website%20and%20I%27m%20interested%20in%20improving%20the%20photos%20of%20my%20property.%20Could%20you%20tell%20me%20more%20about%20your%20services%20and%20pricing%3F","id":"i4ntef-2","target":"_blank","rel":"noopener noreferrer","aria-label":"Chat with us on WhatsApp"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["phone-icon"],"attributes":{"src":"https://api.iconify.design/lucide-message-circle.svg?color=white","alt":"WhatsApp","id":"i1bjzq-2"}},{"tagName":"span","type":"text","name":"Floating WhatsApp Label","components":[{"type":"textnode","content":"WhatsApp"}]}]}]},{"type":"script","attributes":{"id":"iv6ysm"},"components":[{"type":"textnode","content":"\n    const menuToggle = document.getElementById('menuToggle');\n    const mobileMenuContent = document.getElementById('mobileMenuContent');\n    const mobileMenu = document.getElementById('mobileMenu');\n\n    if (menuToggle && mobileMenuContent) {\n      mobileMenuContent.classList.add('hidden');\n\n      menuToggle.addEventListener('click', function () {\n        const isOpen = !mobileMenuContent.classList.contains('hidden');\n        mobileMenuContent.classList.toggle('hidden');\n        menuToggle.setAttribute('aria-expanded', String(!isOpen));\n      });\n\n      document.querySelectorAll('#mobileMenuContent a').forEach(function(link) {\n        link.addEventListener('click', function() {\n          mobileMenuContent.classList.add('hidden');\n          menuToggle.setAttribute('aria-expanded', 'false');\n        });\n      });\n    }\n\n    const portfolioSection = document.getElementById('portfolio');\n    const pricingSection = document.getElementById('pricing');\n    if (portfolioSection && pricingSection && portfolioSection.nextElementSibling !== pricingSection) {\n      portfolioSection.insertAdjacentElement('afterend', pricingSection);\n    }\n\n    const desktopLinks = Array.from(document.querySelectorAll('#iiwvq .navigation-link'));\n    const desktopItems = Array.from(document.querySelectorAll('#iiwvq li'));\n\n    function setActiveNav(hash) {\n      desktopItems.forEach(function(item) {\n        const underline = item.querySelector('.active-underline');\n        const link = item.querySelector('.navigation-link');\n        const isActive = link && link.getAttribute('href') === hash;\n\n        if (underline) {\n          underline.style.display = isActive ? 'block' : 'none';\n        }\n\n        if (link) {\n          link.style.color = isActive ? 'rgb(13 45 90 / 1)' : 'rgb(71 85 105 / 1)';\n        }\n      });\n    }\n\n    function getCurrentSection() {\n      const header = document.querySelector('.site-header');\n      const headerOffset = header ? header.offsetHeight + 120 : 200;\n      let currentHash = '#home';\n\n      desktopLinks.forEach(function(link) {\n        const hash = link.getAttribute('href');\n        if (!hash || !hash.startsWith('#')) return;\n        const section = document.querySelector(hash);\n        if (!section) return;\n\n        const top = section.offsetTop;\n        if (window.scrollY >= top - headerOffset) {\n          currentHash = hash;\n        }\n      });\n\n      return currentHash;\n    }\n\n    function updateActiveOnScroll() {\n      setActiveNav(getCurrentSection());\n    }\n\n    desktopLinks.forEach(function(link) {\n      link.addEventListener('click', function() {\n        const hash = link.getAttribute('href');\n        if (hash) {\n          setActiveNav(hash);\n        }\n      });\n    });\n\n    window.addEventListener('scroll', updateActiveOnScroll, { passive: true });\n    window.addEventListener('load', updateActiveOnScroll);\n    window.addEventListener('resize', updateActiveOnScroll);\n    updateActiveOnScroll();\n  "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"meta","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"title","type":"text","components":[{"type":"textnode","content":"PropertyBoost | Real Estate Photo Enhancement"}]},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@600&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","attributes":{"lang":"en"}}},"id":"ezP28bPw5nyDid3h","minHeight":"500px"}],"id":"yqAmKpXsAir0MG92"}],"symbols":[],"custom":{"projectType":"web","id":""}}